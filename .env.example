# Local demo is explicit, persistent, and synthetic. Set false for Supabase hosting.
DEMO_MODE=true
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
# Local storage path defaults to .relaydesk; never use filesystem demo on Vercel.
DEMO_DATA_DIR=.relaydesk
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Real mode only: configure your own Supabase project and apply migrations manually.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Independent from DEMO_MODE. This release implements only explicit mock billing.
BILLING_PROVIDER=mock

# No silent fallback. Demo uses deterministic fixtures; hosted real mode uses deepseek.
AI_PROVIDER=demo
REAL_INFERENCE_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Set current operator-verified pricing in micro-US-dollars per million tokens.
# Blank/zero rates fail closed for actual inference. No guessed provider pricing.
DEEPSEEK_INPUT_USD_MICROS_PER_MILLION=
DEEPSEEK_OUTPUT_USD_MICROS_PER_MILLION=
# Hard daily cost ceilings, separate from all simulated plan entitlements (1 USD=1000000).
AI_TEST_DAILY_BUDGET_USD_MICROS=100000
AI_IMPORT_DAILY_BUDGET_USD_MICROS=100000
AI_BUSINESS_DAILY_BUDGET_USD_MICROS=500000
AI_GLOBAL_DAILY_BUDGET_USD_MICROS=1000000

# Server-only AES-256-GCM key, 32 random bytes in base64. setup:demo generates one.
CREDENTIAL_ENCRYPTION_KEY=
# Operator-selected currently supported Graph API version; required for Meta calls.
META_GRAPH_VERSION=
META_APP_ID=
META_APP_SECRET=
META_MESSENGER_CONFIG_ID=
META_WHATSAPP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authenticate reconciliation/retention scheduler requests.
CRON_SECRET=
# Optional embeddings: interface and SQL path only. No embedding provider is required.
# No SSLCOMMERZ variables: future integration, not implemented.
